<view class="container">
  <!-- 欢迎消息 -->
  <view class="welcome">
    <view>{{showTime}}，{{userName}}</view>
    <view>想聊点什么？</view>
  </view>
<!-- 对话框的内容 -->
  <view class="chat-container" wx:for="{{chatHistory}}" wx:key="index" wx:for-item="message" data-sender="{{message.sender}}">
    <l-card type="primary" plaintext="{{true}}" title="">
      <view>{{message.content}}</view>
    </l-card>
  </view>
  <l-card type="primary" plaintext="{{true}}" title="🌞当前对话版本:{{selectedModel}}">
    <view class="contentUser">
      <l-card type="primary" plaintext="{{true}}" title="">
        <textarea class="multi-input" placeholder="请输入内容" auto-height value="{{inputValue}}" bindinput="onInput"></textarea>
        <view class="button-container">
          <t-button theme="primary" size="small" variant="outline" shape="round" bindtap="selectModel">版本切换</t-button>
          <t-button theme="danger" size="small" variant="outline" shape="round" bindtap="sendMessage">发送对话</t-button>
        </view>
      </l-card>
    </view>
  </l-card>
</view>