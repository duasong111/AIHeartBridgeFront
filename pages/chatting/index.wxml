<view class="container">

  <!-- 上方是显示AI的对话显示 -->
  <view class="chat-container">
    <view class="AiChatImage">
      <image class="avatar" src="/Image/sun.png"></image>
    </view>
    <view class="AiChating">
      <l-card bindtap="getDetail" data-right-index="{{index}}" type="primary" plaintext="{{true}}" title="">
        <view>有什么可以帮助你的吗？此处显示用户输出的内容</view>
      </l-card>
    </view>
  </view>





  <!-- 这个是显示用户输出的内容 -->
  <view class="contentUser">
    <l-card bindtap="getDetail" data-right-index="{{index}}" type="primary" plaintext="{{true}}" title="">
