.chat-container {
  display: flex;
  align-items: center;
  padding: 10px;
}

.AiChatImage {
  flex-shrink: 0; /* 防止头像被压缩 */
  width: 15%; /* 头像容器占整体 15% 宽度，可自行调整 */
  display: flex;
  justify-content: center; /* 居中对齐 */
  align-items: center;
  background-color: aqua;
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%; /* 圆形头像 */
}

.AiChating {
  /* flex: 1; */
  margin-left: 10px; /* 头像和聊天内容之间的间距 */
  width: 100%; /* 限制聊天框宽度 */
}
.input-example {
  --td-input-vertical-padding: 24rpx;
  background-color: var(--bg-color-demo);
  padding: 32rpx 32rpx 16rpx;
}

.input-example__label {
  color: var(--td-text-color-primary);
  font-size: 24rpx;
  line-height: 40rpx;
  margin: 0 8rpx 16rpx;
}
/* ----------下面是对用户展示的效果---------- */

/* 对用户输入的控制，可以允许进行多行输入 */
.multi-input {
  width: 100%;
  border-radius: 10rpx; /* 添加圆角，调整弧度 */
  min-height: 100rpx; /* 设置最小高度 */
  border: 2rpx solid rgb(238, 232, 232); /* 添加边框，便于查看 */
  padding: 10rpx; /* 内边距 */
  font-size: 32rpx; /* 字体大小 */
}
.button-container {
  display: flex;
  justify-content: flex-end; /* 按钮靠右对齐 */
  gap: 20rpx; /* 按钮之间的间距 */
  margin-right: 10%; /* 距离右边界 10% */
  margin-top: 20rpx; /* 与上方的 textarea 的间距 */
}

