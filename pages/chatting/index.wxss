.chat-container {
  display: flex;
  align-items: center;
  padding: 10px;
}

.AiChatImage {
  flex-shrink: 0; /* 防止头像被压缩 */
  width: 15%; /* 头像容器占整体 15% 宽度，可自行调整 */
  display: flex;
  justify-content: center; /* 居中对齐 */
  align-items: center;
  background-color: aqua;
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%; /* 圆形头像 */
}

.AiChating {
  /* flex: 1; */
  margin-left: 10px; /* 头像和聊天内容之间的间距 */
  width: 100%; /* 限制聊天框宽度 */
}