<view wx:for="{{getPsychometricsList}}" wx:key="index" class='swiper_con' >
	<MyCard type="primary" plaintext="{{true}}" title="本次得分为：{{item.HealthScore}}">
		<view class="returnContent">
			{{item.TopicSummary}}
		</view>
		<view class="card_time ">
			<icon class="iconfont icon-shijian"></icon>{{item.ReturnTime}}
		</view>
	</MyCard>
</view>