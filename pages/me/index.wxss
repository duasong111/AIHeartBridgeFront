page {
  background-color: #ffff;
}

.container {
  /* 其实这里写的是不正规的，不能这样去进行定死的 */
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 用户头像的设置 */
.avatar-container {
  width: 100px;
  height: 100px;
  border-radius: 50%;
  overflow: hidden;
  border: 2px solid rgb(250, 250, 250);
}

.avatar {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 对用户名的设置 */

.userStyle {
  width: 90%;
  margin: 0 auto;
  /* border: rgb(108, 162, 207) 2rpx solid; */
  padding: 10rpx;
  display: flex;
  justify-content: row;
}

.userTitle {
  font-weight: 800;
}

.username {
      margin-left: 10rpx;
      color: skyblue;
      font-weight: 700;
      font-size: larger;
      font-family: Cambria, Cochin, Georgia, Times, ‘Times New Roman’, serif;
}

/* 用户名和邮箱 */
.zone_email {
  border: rgb(108, 162, 207) 2rpx solid;
  padding: 10rpx;
  border-radius: 15rpx;
  display: flex;
  justify-content: space-between;
  width: 90%;
  margin: 20rpx auto;
  font-weight: 800;
}

/* 个性签名总体设计 */
.signature {
  border: skyblue 2rpx solid;
  border-radius: 15rpx;
  width: 90%;
  padding: 5rpx;
  margin: 20rpx auto;
  /* font-weight: 800; */
}

/* 个性签名的头部的设置 */
.signatureHead {
  font-weight: 800;
  margin: 10rpx;
}

/* 个性签名主体内容的设置 */
.signatureBody {
  padding: 10rpx;
  font-weight: 500;
  margin: 10rpx;
  font-family: Cambria, Cochin, Georgia, Times, ‘Times New Roman’, serif;
}

/* 关于底部时间的整体设计 */
.timeStyle {
  width: 90%;
  margin: 0 auto;
  border: skyblue 2rpx solid;
  border-radius: 15rpx;
  display: flex;
  justify-content: row;
  padding: 15rpx;

}

/* 上次登录时间的标题设置 */
.timeHead {
  font-weight: 500;
  font-family: Cambria, Cochin, Georgia, Times, ‘Times New Roman’, serif;
}

/* 底部时间的设置 */
.lasttime {
  font-weight: 500;
  font-family: Cambria, Cochin, Georgia, Times, ‘Times New Roman’, serif;
  margin-left: 30rpx;
  color: rgb(192, 105, 89);
}

.box-container {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  width: 90%;

}

.left-box,
.right-box {
  width: 40%;
  height: 80px;
  border-radius: 10px;
  background-color: rgb(253, 253, 253);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.left-box-setting {
  width: 80%;
  height: 30%;
  font-family: Cambria, Cochin, Georgia, Times, ‘Times New Roman’, serif;
  border: solid 3rpx rgb(219, 216, 216);
  border-radius: 8rpx;
  display: flex;
  background-color: #cdd1d3;
  margin: 6rpx;
  justify-content: center;
  align-items: center;
}

.right-box {
  width: 50%;
}

/* 用户名的设置 */
/* .username {
    margin-top: 20rpx;
    text-align: center;
  } */
/* 底部的功能页面的显示 */
.bottom-show {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  width: 90%;
  background-color: red;
}

.setting {
  margin-top: 30rpx;
  width: 98%;
}

.button {
  width: 100%;
  height: 40px;
  border-radius: 5px;
  background-color: #2376b7;
  color: white;
  font-size: 16px;
  margin: 15rpx;
}