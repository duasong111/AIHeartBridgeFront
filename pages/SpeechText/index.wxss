.container {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.record-btn {
  width: 80%;
  height: 100rpx;
  background-color: #07c160;
  color: white;
  font-size: 32rpx;
  margin: 20rpx 0;
  border-radius: 10rpx;
}

.upload-btn {
  width: 80%;
  height: 100rpx;
  background-color: #1989fa;
  color: white;
  font-size: 32rpx;
  margin: 20rpx 0;
  border-radius: 10rpx;
}

.result {
  margin-top: 40rpx;
  font-size: 32rpx;
  color: #333;
  text-align: center;
}

.error {
  margin-top: 40rpx;
  font-size: 32rpx;
  color: #fa5151;
  text-align: center;
}