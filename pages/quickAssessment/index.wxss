


/*对对话卡片的一些设置 */
.dialogContent{
  margin-top: 10rpx;
}
/* 卡片内部的进行设计 */
.innerContent{
  padding: 5rpx;
  font-weight: 600;
}


/* 对按钮左右两旁的字体设置 */
.leftFont{
  color: #33a474;
  font-size: 34rpx;
  font-weight: 400;

}
.rightFont{
 color: #88619a;
 font-size: 34rpx;
 font-weight: 400;
}


/* 对圆形按钮的设置 */
.selectButton{
  display: flex;
  justify-content: space-between;
  align-items: center;
  /* background-color: aqua; */
  gap: 20rpx;
  padding: 20rpx;
}

/* 对底部提交按钮的布局 */
.btn-container{
  /* margin-left: 100rpx; */
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 40rpxrpx;
  margin-left: 40rpx;
  padding: 20rpx;
}
l-button{
  width: calc(100% - 60rpx);
}