
<!-- 下面是用户进行答题的卡片 -->

<view class="container" wx:for="{{diaglogList}}" wx:key="id">
<div class="dialogContent">
  <l-card type="primary" plaintext="{{true}}" >
    <l-card type="primary" plaintext="{{true}}" >
      <view class="innerContent">
    {{item.content}}
    </view>
    </l-card>
   </l-card>
</div>

<!-- 对用户选择的按钮设置 -->
<view class="selectButton">
  <div class="leftFont"> Agree</div>
  <t-button theme="primary" icon="{{selected === 1 ? 'check' : ''}}" variant="{{selected === 1 ? '' : 'dashed'}}" size="large" shape="circle"  bindtap="onButtonTap" data-index="1">{{selected === 1 ? '' : '1'}}</t-button>
  <t-button theme="primary" icon="{{selected === 2 ? 'check' : ''}}" variant="{{selected === 2 ? '' : 'dashed'}}" size="medium" shape="circle" bindtap="onButtonTap" data-index="2">{{selected === 2 ? '' : '2'}}</t-button>
  <t-button theme="primary" icon="{{selected === 3 ? 'check' : ''}}" variant="{{selected === 3 ? '' : 'dashed'}}" size="small" shape="circle"  bindtap="onButtonTap" data-index="3">{{selected === 3 ? '' : '3'}}</t-button>
  <t-button theme="primary" icon="{{selected === 4 ? 'check' : ''}}" variant="{{selected === 4 ? '' : 'dashed'}}" size="medium" shape="circle" bindtap="onButtonTap" data-index="4">{{selected === 4 ? '' : '4'}}</t-button>
  <t-button theme="primary" icon="{{selected === 5 ? 'check' : ''}}" variant="{{selected === 5 ? '' : 'dashed'}}" size="large" shape="circle"  bindtap="onButtonTap" data-index="5">{{selected === 5 ? '' : '5'}}</t-button>
  
  <div class="rightFont">Disagree</div>

</view>
</view>