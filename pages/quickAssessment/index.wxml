<!-- 下面是用户进行答题的卡片 -->

<view class="container" wx:for="{{dialogList}}" wx:key="id" wx:for-index="idx">
  <div class="dialogContent">
    <l-card type="primary" plaintext="{{true}}">
      <l-card type="primary" plaintext="{{true}}">
        <view class="innerContent">
          {{item.testTitile}}
        </view>
      </l-card>
    </l-card>
  </div>
  <!-- 对用户选择的按钮设置 -->
  <view class="selectButton">
    <div class="rightFont">Disagree</div>
    <t-button theme="primary" icon="{{item.score === 1 ? 'check' : ''}}" variant="{{item.score === 1 ? '' : 'dashed'}}" size="large" shape="circle" bindtap="onButtonTap" data-question-index="{{idx}}" data-index="1">{{item.score === 1 ? '' : '1'}}</t-button>
    <t-button theme="primary" icon="{{item.score === 2 ? 'check' : ''}}" variant="{{item.score === 2 ? '' : 'dashed'}}" size="medium" shape="circle" bindtap="onButtonTap" data-question-index="{{idx}}" data-index="2">{{item.score === 2 ? '' : '2'}}</t-button>
    <t-button theme="primary" icon="{{item.score === 3 ? 'check' : ''}}" variant="{{item.score === 3 ? '' : 'dashed'}}" size="small" shape="circle" bindtap="onButtonTap" data-question-index="{{idx}}" data-index="3">{{item.score === 3 ? '' : '3'}}</t-button>
    <t-button theme="primary" icon="{{item.score === 4 ? 'check' : ''}}" variant="{{item.score === 4 ? '' : 'dashed'}}" size="medium" shape="circle" bindtap="onButtonTap" data-question-index="{{idx}}" data-index="4">{{item.score === 4 ? '' : '4'}}</t-button>
    <t-button theme="primary" icon="{{item.score === 5 ? 'check' : ''}}" variant="{{item.score === 5 ? '' : 'dashed'}}" size="large" shape="circle" bindtap="onButtonTap" data-question-index="{{idx}}" data-index="5">{{item.score === 5 ? '' : '5'}}</t-button>
    <div class="leftFont"> Agree</div>
  </view>



</view>
<l-card type="primary" plaintext="{{true}}">
  <view class="btn-container">
    <l-button type="success" shape="semicircle" bindtap="submitAnswers">提交</l-button>
    <l-button type="default" shape="semicircle" bindtap="submitReset">重置</l-button>
  </view>
</l-card>


