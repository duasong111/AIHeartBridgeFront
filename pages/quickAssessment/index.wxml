<l-dialog 
  show="{{dialogShow}}"
  type="confirm"  
  title="您的最终得分：{{recordUserScore[recordUserScore.length - 1]}}" 
  content="{{AISuggestions}}"
  confirm-text="确定"
  bind:linconfirm="confirmFunction"
  confirm-color="#f60"
  cancel-text="重试"
  bind:lincancel="submitReset"
  cancel-color="#999" />