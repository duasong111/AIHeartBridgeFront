<!-- <l-notice-bar show="{{true}}"  type="roll" speed="2000">我是通告栏</l-notice-bar> -->
<view class="container">
<!-- 添加一个通告栏 -->
<view class="noticeTable">
    <l-notice-bar  front-icon-name="notification"  show="{{bulletinBoard.is_show}}" close="{{true}}">{{bulletinBoard.content}}</l-notice-bar>
</view>
  <!-- 轮播图 -->
  <view class="carouselChart">
    <swiper autoplay="{{true}}" circular="{{true}}" indicator-dots="{{true}}" interval="3000" indicator-color="#afafb0" indicator-active-color="#ffffff">
      <swiper-item wx:for="{{imagsult}}" wx:key="index" style="width:{{ images[index].width }}rpx; height:{{ images[index].height }}rpx; justify-content:center;align-items:center;display: flex;">
        <image mode="widthFix" src="https://cn.bing.com/{{item.url}}" />
        <view class="content">{{item.copyright}}</view>
      </swiper-item>
    </swiper>
  </view>
  <!-- 展示的则是下边俩不对称的框 -->
  <view class="box-bottom">
    <view bindtap="quickAssess" class="left-box">
      <!-- 在这个里边去来进行显示快速测评 -->
      <view class="showFont">
        <icon class="iconfont icon-monkey" />
        <view class="fontbeauty">快速测评</view>
      </view>
    </view>
    <view bindtap="dailyRecom" class="right-box">
      <view class="showFont">
        <icon class="iconfont icon-fengche" />
        <view class="fontbeauty">每日推荐</view>
      </view>
    </view>
  </view>
  <!-- 展示壹心理的每日新闻推荐的进行新闻 -->
  <view class="showNews">
    <view class='topTabSwiper'>
      <view class='tab  {{currentData == 0 ? "tabBorer" : ""}}' data-current="0" bindtap='checkCurrent'>壹心理</view>
      <view class='tab  {{currentData == 1 ? "tabBorer" : ""}}' data-current="1" bindtap='checkCurrent'>活动详情</view>
      <!-- <view class='tab  {{currentData == 2 ? "tabBorer" : ""}}' data-current="2" bindtap='checkCurrent'>功能3</view> -->
      <!-- <view class='tab  {{currentData == 3 ? "tabBorer" : ""}}' data-current="3" bindtap='checkCurrent'>功能4</view>
      <view class='tab  {{currentData == 4 ? "tabBorer" : ""}}' data-current="4" bindtap='checkCurrent'>功能5</view> -->
    </view>
    <swiper current="{{currentData}}" class='swiper' style="height:600px;" duration="300" bindchange="bindchange">
      <swiper-item>
        <!-- 现在这俩是一样的，要进行修改,给其变成不一样的 -->
        <view class='swiperNews'>
          <!-- 展示比赛的有关信息 -->
          <view wx:for="{{getNews}}" wx:key="index" class='swiperNews' wx:if="{{item.is_show}}">
            <l-card type="primary" plaintext="{{true}}" title="✨ {{item.title}} ">
              <view class="swiperContent">
                {{item.content}}
              </view>
              <view class="card_time ">
                <icon class="iconfont icon-shijian"></icon>{{item.dates}}
              </view>
            </l-card>
          </view>
        </view>
      </swiper-item>
      <swiper-item>
        <view class='swiper_con'>
          <!-- 展示比赛的有关信息 -->
          <view wx:for="{{getCompetitionNotifications}}" wx:key="index" class='swiper_con' wx:if="{{item.is_show}}">
            <l-card type="primary" plaintext="{{true}}" title="📢 {{item.title}}">
              <view class="noticeContent">
                {{item.content}}
              </view>
              <view class="card_time ">
                <icon class="iconfont icon-shijian"></icon>{{item.date}}
              </view>
            </l-card>
          </view>
        </view>
      </swiper-item>
    </swiper>
  </view>
</view>